# Copy to .env and fill in. Never commit .env.

# AI provider for the advisor: "gemini", "groq" or "none".
# "none" runs fully offline with the built-in rules + templates (no key needed).
LLM_PROVIDER=none

# Google AI Studio key (free tier, no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq key (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Secret used to sign the consent ledger hash chain and partner tokens.
APP_SECRET=change-me-in-production

# Days after successful verification before uploaded KYC documents are purged.
DOC_RETENTION_DAYS=30

# The case says to treat this date as "today" for date checks.
REFERENCE_DATE=2026-07-15
